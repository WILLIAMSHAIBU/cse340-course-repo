<%- include('partials/header', { title }) %>

<main>
    <h2>Upcoming Service Projects</h2>
    <div class="card-grid">
        <% service_projects.forEach(project => { %>
            <div class="card project-card">
                <div class="card-content">
                    <h3><a href="/project/<%= project.project_id %>"><%= project.title %></a></h3>
                    <p class="card-description"><%= project.description %></p>
                    <div class="card-meta">
                        <% if (project.location) { %>
                            <span class="meta-item">📍 <%= project.location %></span>
                        <% } %>
                        <% if (project.project_date) { %>
                            <span class="meta-item">📅 <%= new Date(project.project_date).toLocaleDateString() %></span>
                        <% } %>
                    </div>
                </div>
            </div>
        <% }); %>
    </div>
    <% if (user && user.role_name === 'admin') { %>
        <div class="admin-actions">
            <a href="/new-project" class="btn-primary">Add a New Service Project</a>
        </div>
    <% } %>
</main>

<%- include('partials/footer') %>