<%- include('partials/header') %>
<main>
    <h2><%= title %></h2>

    <div class="detail-header">
        <img src="/images/<%= organizationDetails.logo_filename %>" alt="<%= organizationDetails.name %> logo" class="detail-logo">
        <div class="detail-info">
            <h3><%= organizationDetails.name %></h3>
            <p class="detail-email"><%= organizationDetails.contact_email %></p>
        </div>
    </div>

    <div class="detail-section">
        <h4>Description</h4>
        <p><%= organizationDetails.description %></p>
    </div>

    <% if (projects && projects.length > 0) { %>
        <div class="detail-section">
            <h4>Projects</h4>
            <ul class="detail-list">
                <% projects.forEach(project => { %>
                    <li><a href="/project/<%= project.project_id %>"><%= project.title %></a></li>
                <% }) %>
            </ul>
        </div>
    <% } else { %>
        <div class="detail-section">
            <p class="empty-state">No projects yet.</p>
        </div>
    <% } %>

    <div class="detail-actions">
        <% if (user && user.role_name === 'admin') { %>
            <a href="/edit-organization/<%= organizationDetails.organization_id %>" class="btn-primary">Edit Organization</a>
        <% } %>
        <a href="/organizations" class="btn-secondary">Back to all organizations</a>
    </div>
</main>
<%- include('partials/footer') %>
