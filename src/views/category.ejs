<%- include('partials/header') %>
<main>
    <h2><%= title %></h2>

    <div class="detail-header">
        <div class="detail-info">
            <h3><%= categoryDetails.name %></h3>
        </div>
    </div>

    <div class="detail-section">
        <h4>Projects</h4>
        <% if (projects && projects.length > 0) { %>
            <ul class="detail-list">
                <% projects.forEach(project => { %>
                    <li><a href="/project/<%= project.project_id %>"><%= project.title %></a></li>
                <% }) %>
            </ul>
        <% } else { %>
            <p class="empty-state">No projects in this category yet.</p>
        <% } %>
    </div>

    <div class="detail-actions">
        <% if (user && user.role_name === 'admin') { %>
            <a href="/edit-category/<%= categoryDetails.category_id %>" class="btn-primary">Edit Category</a>
        <% } %>
        <a href="/categories" class="btn-secondary">Back to all categories</a>
    </div>
</main>
<%- include('partials/footer') %>
