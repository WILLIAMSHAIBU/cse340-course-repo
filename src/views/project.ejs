<%- include('partials/header') %>
<main>
    <h2><%= title %></h2>

    <div class="detail-header">
        <div class="detail-info">
            <h3><%= projectDetails.title %></h3>
            <div class="detail-meta">
                <% if (projectDetails.location) { %>
                    <span class="meta-item">📍 <%= projectDetails.location %></span>
                <% } %>
                <% if (projectDetails.project_date) { %>
                    <span class="meta-item">📅 <%= new Date(projectDetails.project_date).toLocaleDateString() %></span>
                <% } %>
            </div>
        </div>
    </div>

    <div class="detail-section">
        <h4>Description</h4>
        <p><%= projectDetails.description %></p>
    </div>

    <div class="detail-section">
        <h4>Categories</h4>
        <div class="category-tags">
            <% categories.forEach(category => { %>
                <a href="/category/<%= category.category_id %>" class="category-tag"><%= category.name %></a>
            <% }) %>
        </div>
    </div>

    <div class="detail-actions">
        <% if (user && user.role_name === 'admin') { %>
            <a href="/edit-project/<%= projectDetails.project_id %>" class="btn-primary">Edit Project</a>
            <a href="/assign-categories/<%= projectDetails.project_id %>" class="btn-secondary">Edit Categories</a>
        <% } %>
        <a href="/projects" class="btn-secondary">Back to all projects</a>
    </div>
</main>
<%- include('partials/footer') %>
